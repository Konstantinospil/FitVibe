{
  "name": "glob",
  "version": "10.5.1",
  "description": "Vendored glob@10.5.0 (GHSA-5j98-mcp5-4vw2) shipped as a workspace override.",
  "license": "ISC",
  "type": "module",
  "bin": "./dist/esm/bin.mjs",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "foreground-child": "^4.0.3",
    "minimatch": "^10.2.6",
    "jackspeak": "^4.2.3",
    "minipass": "^7.1.3",
    "package-json-from-dist": "^1.0.0",
    "path-scurry": "^2.0.2"
  }
}
