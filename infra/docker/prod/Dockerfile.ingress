FROM nginx:1.31-alpine

# Refresh Alpine OS packages in the shipped runtime image (not just the tag).
RUN apk upgrade --no-cache

COPY infra/docker/prod/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O - http://127.0.0.1/__ingress_health >/dev/null 2>&1 || exit 1
