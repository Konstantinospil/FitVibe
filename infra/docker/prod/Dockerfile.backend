## ===============================================================
## FitVibe Backend - Monorepo Build Pipeline (Optimized)
## ===============================================================

FROM node:24-alpine AS builder
WORKDIR /app

ENV HUSKY=0

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc .pnpmfile.cjs ./
COPY apps/backend/package.json apps/backend/
COPY packages/*/package.json packages/*/

RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
RUN pnpm fetch --prod=false

COPY . .

RUN pnpm install --frozen-lockfile --prod=false --offline
RUN pnpm --filter @fitvibe/backend run build
RUN pnpm deploy --filter @fitvibe/backend --prod /app/backend-deploy

FROM node:24-alpine AS runtime
WORKDIR /app

COPY --from=builder /app/backend-deploy/ ./
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /app/apps/frontend/src/i18n/locales ./legal-authoring-locales

# Fail during image build, rather than at container startup, if archiver's
# production dependency graph is incomplete.
RUN node -e "require('archiver'); console.log('archiver runtime dependencies OK')"

RUN addgroup -S nodeapp && adduser -S nodeapp -G nodeapp
USER nodeapp

ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000

CMD ["node", "dist/server.js"]
## ===============================================================
