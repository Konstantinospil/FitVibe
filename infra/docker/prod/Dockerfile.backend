## ===============================================================
## FitVibe Backend - Monorepo Build Pipeline (Optimized)
## ===============================================================

FROM node:24-alpine AS builder
WORKDIR /app

# Docker needs pnpm >=12.9.0 for the fixed legacy deploy handling of
# relative file:/link: dependencies. Keep this override scoped to the
# image build; the repository-wide packageManager pin remains unchanged.
ENV HUSKY=0 \
    pnpm_config_pm_on_fail=ignore

# pnpm fetch is lockfile-driven. Avoid wildcard COPY destinations for
# workspace manifests because Docker treats the destination wildcard
# literally and would create /app/packages/* as a workspace directory.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc .pnpmfile.cjs ./

RUN corepack enable && corepack prepare pnpm@12.9.0 --activate
RUN test "$(pnpm --version)" = "12.9.0"
RUN pnpm fetch --prod=false

COPY . .

RUN pnpm install --frozen-lockfile --prod=false --offline
RUN pnpm --filter @fitvibe/backend run build
RUN pnpm deploy --legacy --filter @fitvibe/backend --prod /app/backend-deploy

FROM node:24-alpine AS runtime
WORKDIR /app

COPY --from=builder /app/backend-deploy/ ./
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /app/apps/frontend/src/i18n/locales ./legal-authoring-locales

# Fail during image build, rather than at container startup, if archiver's
# production dependency graph is incomplete.
RUN node -e "require('archiver'); console.log('archiver runtime dependencies OK')"

RUN addgroup -S nodeapp && adduser -S nodeapp -G nodeapp
USER nodeapp

ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000

CMD ["node", "dist/server.js"]
## ===============================================================
