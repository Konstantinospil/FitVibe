## ===============================================================
## FitVibe Backoffice - Production Static Build
## ===============================================================

FROM node:24-alpine AS builder
WORKDIR /app

ENV HUSKY=0 \
    COREPACK_ENABLE_PROJECT_SPEC=0 \
    pnpm_config_pm_on_fail=ignore

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc .pnpmfile.cjs ./
RUN corepack enable && corepack prepare pnpm@12.9.0 --activate
RUN test "$(pnpm --version)" = "12.9.0"
RUN pnpm fetch --prod=false

COPY . .
RUN pnpm install --frozen-lockfile --prod=false --offline
RUN pnpm --filter @fitvibe/backoffice run build

FROM nginx:1.29-alpine AS runtime

COPY infra/docker/prod/backoffice.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/backoffice/dist /usr/share/nginx/html

EXPOSE 8080
