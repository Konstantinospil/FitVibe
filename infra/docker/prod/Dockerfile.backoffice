## ===============================================================
## FitVibe Backoffice - Production Static Build
## ===============================================================

FROM node:24-alpine AS builder
WORKDIR /app

# pnpm comes from the root package.json `packageManager` field, the same
# version CI and the lockfile use; do not pin a different version here.
ENV HUSKY=0

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .pnpmfile.cjs ./
RUN corepack enable && corepack install
RUN test "pnpm@$(pnpm --version)" = "$(node -p "require('./package.json').packageManager")"
RUN pnpm fetch --prod=false

COPY . .
RUN pnpm install --frozen-lockfile --prod=false --offline
RUN pnpm --filter @fitvibe/backoffice run build

FROM nginx:1.31-alpine AS runtime

# Refresh Alpine OS packages in the shipped runtime image (not just the tag).
RUN apk upgrade --no-cache

COPY infra/docker/prod/backoffice.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/backoffice/dist /usr/share/nginx/html

EXPOSE 8080
