## ===============================================================
## FitVibe Frontend - Monorepo Build Pipeline
## ===============================================================

# ---------- Builder Stage ----------
FROM node:24-alpine AS builder
WORKDIR /app

# Docker needs pnpm >=12.9.0 for the fixed legacy deploy handling of
# relative file:/link: dependencies. Keep this override scoped to the
# image build; the repository-wide packageManager pin remains unchanged.
ENV HUSKY=0 \
    pnpm_config_pm_on_fail=ignore

# 1) Copy only the lockfile/config inputs needed by pnpm fetch.
#    Avoid wildcard COPY destinations for workspace manifests because
#    Docker treats the destination wildcard literally as /app/packages/*.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc .pnpmfile.cjs ./

# 2) Use the fixed Docker-local pnpm release and pre-fetch dependencies.
RUN corepack enable && corepack prepare pnpm@12.9.0 --activate
RUN test "$(pnpm --version)" = "12.9.0"
RUN pnpm fetch --prod=false

# 3) Copy the complete workspace after the dependency cache is populated.
COPY . .

# 4) Link node_modules (dev deps included for build tooling)
RUN pnpm install --frozen-lockfile --prod=false --offline

# 5) Build the frontend workspace package (SSR build)
RUN pnpm --filter @fitvibe/frontend run build:ssr

# 6) Isolate the frontend package + production node_modules
RUN pnpm deploy --legacy --filter @fitvibe/frontend --prod /app/frontend-deploy

# ---------- Runtime Stage ----------
FROM node:24-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/frontend-deploy/ ./
# dist/ is gitignored, so pnpm deploy does not include the SSR build output
COPY --from=builder /app/apps/frontend/dist ./dist
COPY --from=builder /app/apps/frontend/server.ts ./server.ts
COPY --from=builder /app/apps/frontend/index.html ./index.html
COPY --from=builder /app/apps/frontend/src/ssr ./src/ssr

RUN addgroup -S nodeapp && adduser -S nodeapp -G nodeapp && \
    chown -R nodeapp:nodeapp /app

USER nodeapp

EXPOSE 4173

ENV NODE_ENV=production
ENV PORT=4173

CMD ["./node_modules/.bin/tsx", "server.ts"]
## ===============================================================
