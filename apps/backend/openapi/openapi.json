          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/complete": {
      "patch": {
        "summary": "Mark session complete",
        "tags": [
          "Sessions"
        ],
        "security": [
          {
            "bearerAuth": []
