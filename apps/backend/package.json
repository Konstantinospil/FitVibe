{
  "name": "@fitvibe/backend",
  "version": "2.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/server.js",
    "lint": "eslint \"src\" \"../../tests/backend\" --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 jest --runInBand --testMatch=\"**/integration/**/*.test.ts\" --testPathIgnorePatterns=\"/node_modules/|verification-resend-limit\\.test\\.ts$|login-enumeration\\.test\\.ts$\"",
    "openapi:build": "node scripts/generate-openapi.mjs",
    "db:retention": "tsx src/db/scripts/run-retention.ts",
    "db:rotate-secrets": "tsx src/db/scripts/rotate-secrets.ts",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:seed": "tsx src/db/utils/seedAll.ts",
    "db:check-i18n": "tsx src/db/scripts/check-i18n-db.ts",
    "db:import-translations": "tsx src/db/scripts/import-translations.ts",
    "auth:bootstrap-superadmin": "tsx scripts/bootstrap-superadmin.ts",
    "docs:test-suite": "node scripts/generate-test-suite-doc.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@otplib/preset-default": "^12.0.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.17",
    "clamscan": "^2.4.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "csrf": "^3.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.1.7",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
