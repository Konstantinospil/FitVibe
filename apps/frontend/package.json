{
  "name": "@fitvibe/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:visual": "node ./scripts/build-visual.mjs",
    "build:client": "USE_REACT=true tsc -p tsconfig.build.json && USE_REACT=true vite build",
    "build:server": "SSR=true vite build --ssr src/ssr/render.tsx",
    "build:static": "tsx scripts/generate-static.ts",
    "build:ssr": "pnpm build:client && pnpm build:server && pnpm build:static",
    "preview": "vite preview",
    "start:ssr": "tsx server.ts",
    "lint": "eslint \"src\" \"../../tests/frontend\" --max-warnings=0",
    "lint:check": "turbo run lint -- --max-warnings=0",
    "typecheck": "tsc --noEmit && node -e \"const fs=require('fs');const path=require('path');const testsDir=path.join(__dirname,'tests');if(fs.existsSync(testsDir)){const files=fs.readdirSync(testsDir,{recursive:true});if(files.some(f=>/\\\\.(ts|tsx)$/.test(f))){require('child_process').execSync('tsc --noEmit -p tsconfig.test.json',{stdio:'inherit'});}}\"",
    "test": "node ./scripts/run-vitest.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.15.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "i18next": "^23.10.1",
    "lucide-react": "^1.45.0",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^13.5.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15",
    "@fitvibe/ui": "workspace:*"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
