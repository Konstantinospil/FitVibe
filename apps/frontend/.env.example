# FitVibe Frontend Environment Configuration
# Copy this file to .env.local and configure with your values

# ==============================================================================
# API Configuration
# ==============================================================================
# Backend API URL (no trailing slash)
VITE_API_URL=http://localhost:4000

# ==============================================================================
# Feature Flags
# ==============================================================================
# VITE_FEATURE_2FA_ENABLED=false
# VITE_FEATURE_SOCIAL_FEED=true
# VITE_FEATURE_AI_TRANSLATION=false

# ==============================================================================
# Analytics & Monitoring
# ==============================================================================
# VITE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==============================================================================
# External Services
# ==============================================================================
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxx

# ==============================================================================
# Social Media
# ==============================================================================
# Leave unset to render the corresponding footer icon as disabled.
# VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/your-account
# VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/your-account
# VITE_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@your-account
# VITE_SOCIAL_GITHUB_URL=https://github.com/your-account
