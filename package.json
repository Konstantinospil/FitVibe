{
  "name": "fitvibe",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint --parallel",
    "lint:check": "turbo run lint --concurrency=1 -- --max-warnings=0",
    "test": "turbo run test --",
    "test:backend": "turbo run test --filter=@fitvibe/backend -- --coverage",
    "test:frontend": "turbo run test --filter=@fitvibe/frontend -- --coverage",
    "test:a11y": "pnpm --filter @fitvibe/frontend run build && playwright test tests/frontend/e2e/accessibility.spec.cjs --config tests/frontend/e2e/playwright.config.cjs --reporter=line",
    "test:e2e:smoke": "pnpm --filter @fitvibe/frontend run build && playwright test tests/frontend/e2e/smoke.spec.cjs --config tests/frontend/e2e/playwright.config.cjs --reporter=line",
    "test:contract": "pnpm -w openapi:build && pnpm --filter @fitvibe/backend exec jest tests/backend/contract/openapi.contract.test.ts --maxWorkers=1",
    "test:integration": "RUN_INTEGRATION_TESTS=1 pnpm --filter @fitvibe/backend exec jest --runInBand --testMatch=\"**/integration/**/*.test.ts\" --testPathIgnorePatterns=\"/node_modules/|verification-resend-limit\\.test\\.ts$|login-enumeration\\.test\\.ts$\"",
    "test:visual": "node tests/frontend/visual/scripts/update-linux-baselines.mjs",
    "test:visual:ci": "playwright test --config tests/frontend/visual/config/playwright.config.ts --update-snapshots=none",
    "test:visual:update": "node tests/frontend/visual/scripts/update-linux-baselines.mjs --update",
    "test:visual:linux": "node tests/frontend/visual/scripts/update-linux-baselines.mjs",
    "test:coverage:gate": "node tests/qa/check-coverage.cjs",
    "perf:test": "node tests/perf/run-local-perf.mjs",
    "perf:lhci": "node tests/perf/run-lhci-local.mjs",
    "test:lhci:config": "node --test tests/perf/lighthouse-ci-config.test.cjs tests/perf/lighthouse-measurement-validity.test.cjs tests/perf/lighthouse-observe-navigation.test.cjs tests/perf/lighthouse-public-scenarios.test.cjs tests/perf/lighthouse-route-coverage.test.cjs tests/perf/lighthouse-score-contract.test.cjs tests/perf/lighthouse-performance-report.test.cjs tests/perf/ssr-diagnostics.test.cjs",
    "qa:summary": "node tests/qa/generate-summary.mjs",
    "i18n:check": "node tests/qa/check-i18n.cjs",
    "ui-literals:audit": "node tests/qa/audit-ui-literals.cjs --json tests/qa/reports/ui-literals.json --md tests/qa/reports/ui-literals.md",
    "ui-literals:strict": "node tests/qa/audit-ui-literals.cjs --strict",
    "ui-literals:test": "node --test tests/qa/audit-ui-literals.test.cjs",
    "ui-data-contracts:audit": "node tests/qa/audit-ui-data-contracts.cjs --json tests/qa/reports/ui-data-contracts.json --md tests/qa/reports/ui-data-contracts.md",
    "ui-data-contracts:strict": "node tests/qa/audit-ui-data-contracts.cjs --strict",
    "ui-localization:test": "node --test tests/qa/audit-ui-literals.test.cjs tests/qa/audit-ui-contract-runtime.test.cjs tests/qa/first500-localization.test.cjs tests/qa/second500-localization.test.cjs tests/qa/third500-localization.test.cjs",
    "i18n:check:db": "pnpm --filter @fitvibe/backend run db:check-i18n",
    "test:skips": "node tests/qa/assert-no-unexpected-skips.cjs",
    "test:no-silent-returns": "node tests/qa/assert-no-silent-test-returns.cjs",
    "test:lifecycle": "node tests/qa/assert-test-lifecycle.cjs",
    "security:scan": "node tests/security/run-security-checks.mjs",
    "typecheck": "turbo run typecheck",
    "openapi:build": "pnpm --filter @fitvibe/backend run openapi:build",
    "retention:run": "pnpm --filter @fitvibe/backend run db:retention",
    "secrets:rotate": "pnpm --filter @fitvibe/backend run db:rotate-secrets",
    "clean": "rimraf node_modules .turbo && pnpm install",
    "prepare": "husky install",
    "fmt": "prettier \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml}\" --write",
    "test:visual:update:linux": "node tests/frontend/visual/scripts/update-linux-baselines.mjs --update",
    "architecture:backend": "node tests/qa/check-architecture-hardcoding.mjs backend",
    "architecture:frontend-tokens": "node tests/qa/check-architecture-hardcoding.mjs frontend-tokens",
    "architecture:frontend-reuse": "node tests/qa/check-architecture-hardcoding.mjs frontend-reuse",
    "architecture:check": "node tests/qa/check-architecture-hardcoding.mjs all && node --test tests/qa/design-authority-core.test.mjs && node tests/qa/audit-design-authority.mjs",
    "architecture:design-audit": "node tests/qa/audit-design-authority.mjs",
    "architecture:design-tests": "node --test tests/qa/design-authority-core.test.mjs",
    "architecture:design-strict": "node tests/qa/audit-design-authority.mjs --strict",
    "quality:package-json": "node tests/qa/check-package-json.cjs && node tests/qa/check-dependency-overrides.cjs",
    "test:backoffice": "pnpm --filter @fitvibe/backoffice run build && playwright test --config tests/backoffice/e2e/playwright.config.cjs",
    "typography:check": "node tests/qa/check-typography-contract.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.37.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "istanbul-lib-coverage": "^3.2.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.6.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pnpm": "12.16.1",
    "prettier": "3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "postcss": "8.5.32",
    "lighthouse": "13.6.0"
  },
  "dependencies": {
    "snyk": "^1.1308.3"
  }
}
