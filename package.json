{
  "name": "fitvibe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint --parallel",
    "lint:check": "turbo run lint --concurrency=1 -- --max-warnings=0",
    "test": "turbo run test --",
    "test:backend": "turbo run test --filter=@fitvibe/backend -- --coverage",
    "test:frontend": "turbo run test --filter=@fitvibe/frontend -- --coverage",
    "test:a11y": "pnpm --filter @fitvibe/frontend run build && playwright test tests/frontend/e2e/accessibility.spec.cjs --config tests/frontend/e2e/playwright.config.cjs --reporter=line",
    "test:e2e:smoke": "pnpm --filter @fitvibe/frontend run build && playwright test tests/frontend/e2e/smoke.spec.cjs --config tests/frontend/e2e/playwright.config.cjs --reporter=line",
    "test:contract": "pnpm -w openapi:build && pnpm --filter @fitvibe/backend exec jest tests/backend/contract/openapi.contract.test.ts --maxWorkers=1",
    "test:integration": "RUN_INTEGRATION_TESTS=1 pnpm --filter @fitvibe/backend exec jest --runInBand --testMatch=\"**/integration/**/*.test.ts\" --testPathIgnorePatterns=\"/node_modules/|verification-resend-limit\\.test\\.ts$|login-enumeration\\.test\\.ts$\"",
    "test:visual": "node tests/frontend/visual/scripts/update-linux-baselines.mjs",
    "test:visual:ci": "playwright test --config tests/frontend/visual/config/playwright.config.ts --update-snapshots=none",
    "test:visual:update": "node tests/frontend/visual/scripts/update-linux-baselines.mjs --update",
    "test:visual:linux": "node tests/frontend/visual/scripts/update-linux-baselines.mjs",
    "test:coverage:gate": "node tests/qa/check-coverage.cjs",
    "perf:test": "node tests/perf/run-local-perf.mjs",
    "perf:lhci": "node tests/perf/run-lhci-local.mjs",
    "qa:summary": "node tests/qa/generate-summary.mjs",
    "i18n:check": "node tests/qa/check-i18n.cjs",
    "i18n:check:db": "pnpm --filter @fitvibe/backend run db:check-i18n",
    "test:skips": "node tests/qa/assert-no-unexpected-skips.cjs",
    "test:no-silent-returns": "node tests/qa/assert-no-silent-test-returns.cjs",
    "security:scan": "node tests/security/run-security-checks.mjs",
    "typecheck": "turbo run typecheck",
    "openapi:build": "pnpm --filter @fitvibe/backend run openapi:build",
    "retention:run": "pnpm --filter @fitvibe/backend run db:retention",
    "secrets:rotate": "pnpm --filter @fitvibe/backend run db:rotate-secrets",
    "clean": "rimraf node_modules .turbo && pnpm install",
    "prepare": "husky install",
    "fmt": "prettier \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml}\" --write",
    "test:visual:update:linux": "node tests/frontend/visual/scripts/update-linux-baselines.mjs --update",
    "architecture:backend": "node tests/qa/check-architecture-hardcoding.mjs backend",
    "architecture:frontend-tokens": "node tests/qa/check-architecture-hardcoding.mjs frontend-tokens",
    "architecture:frontend-reuse": "node tests/qa/check-architecture-hardcoding.mjs frontend-reuse",
    "architecture:check": "node tests/qa/check-architecture-hardcoding.mjs all",
    "quality:package-json": "node tests/qa/check-package-json.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.37.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.3",
    "istanbul-lib-coverage": "^3.2.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.6.3",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pnpm": "12.7.0",
    "prettier": "3.9.9",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "js-yaml": ">=4.3.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.123.0",
    "openai": "^7.8.0",
    "snyk": "^1.1307.4"
  }
}
